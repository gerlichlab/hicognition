# The demo with the publication's showcase data (docker_demo.yml). Its Python environment is the
# backend image's (Dockerfile); built from the repository's root.
FROM python:3.13-slim-trixie

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_ROOT_USER_ACTION=ignore \
    POETRY_VIRTUALENVS_CREATE=false \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

# add showcase directory
ADD ./publication/showcase_data /showcase_data

# download showcase data
RUN cd /showcase_data \
    && curl -L --silent -o raw_data.tar.gz https://www.dropbox.com/s/6mmmqrwwy1x2dlt/raw_data.tar.gz?dl=0 \
    && tar -xf raw_data.tar.gz

RUN python -m venv /opt/poetry && /opt/poetry/bin/pip install poetry==2.5.1 \
    && python -m venv /opt/venv

WORKDIR /code
COPY ./back_end/pyproject.toml ./back_end/poetry.lock ./
RUN /opt/poetry/bin/poetry sync --no-root

# add code directory so production code is packaged
COPY ./back_end/ /code

ENTRYPOINT /code/boot_showcase.sh
